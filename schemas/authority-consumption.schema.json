{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/schemas/authority-consumption.schema.json",
  "title": "Praxis authority receipt consumption record v1",
  "description": "Normalized durable result of a successful single-use compare-and-set operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "provider",
    "project_id",
    "operation_id",
    "plan_fingerprint",
    "payload_digest",
    "consumed_at",
    "consumer_identity",
    "result"
  ],
  "properties": {
    "schema": {"const": "praxis/authority-consumption/v1"},
    "receipt_id": {"type": "string", "minLength": 12},
    "provider": {"type": "string", "minLength": 3},
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "operation_id": {"type": "string", "minLength": 8},
    "plan_fingerprint": {"$ref": "#/$defs/digest"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "consumer_identity": {"type": "string", "minLength": 3},
    "result": {"const": "consumed"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
