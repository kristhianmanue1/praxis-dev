{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/schemas/spec-metadata.schema.json",
  "title": "Praxis SPEC metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "version",
    "created_at",
    "governed_by",
    "adr_exception_reason",
    "covers",
    "valid_from",
    "supersedes"
  ],
  "properties": {
    "schema": {"const": "praxis/spec-metadata/v1"},
    "id": {"type": "string", "pattern": "^SPEC-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 160},
    "status": {"enum": ["draft", "review", "approved", "deprecated", "superseded"]},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "governed_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(ADR-[0-9]{4}|none)$"}
    },
    "adr_exception_reason": {
      "oneOf": [{"type": "string", "minLength": 12}, {"type": "null"}]
    },
    "covers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relative_path"}
    },
    "valid_from": {
      "oneOf": [{"$ref": "#/$defs/revision"}, {"type": "null"}]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SPEC-[0-9]{4}$"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "governed_by": {"contains": {"const": "none"}}
        }
      },
      "then": {
        "properties": {
          "governed_by": {"maxItems": 1},
          "adr_exception_reason": {"type": "string", "minLength": 12}
        }
      },
      "else": {
        "properties": {"adr_exception_reason": {"type": "null"}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {
        "properties": {
          "covers": {"minItems": 1},
          "valid_from": {"$ref": "#/$defs/revision"}
        }
      }
    }
  ],
  "$defs": {
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "git_commit"},
            "value": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "release"},
            "value": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
            }
          }
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
