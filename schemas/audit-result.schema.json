{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/schemas/audit-result.schema.json",
  "title": "Praxis audit result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool_version",
    "standard_version",
    "project_id",
    "observed_revision",
    "profile",
    "result",
    "level",
    "findings",
    "diagnostics",
    "observed_at"
  ],
  "properties": {
    "schema": {"const": "praxis/audit-result/v1"},
    "tool_version": {"type": "string", "minLength": 1},
    "standard_version": {"type": "string", "minLength": 1},
    "project_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        {"type": "null"}
      ]
    },
    "observed_revision": {
      "oneOf": [
        {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        {"type": "null"}
      ]
    },
    "profile": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "inconclusive"]},
    "level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message", "evidence", "remediation"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "severity": {"enum": ["BLOCKER", "HIGH", "MED", "LOW", "INFO"]},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "object"},
          "remediation": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "level", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 3},
          "level": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
