{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxis.dev/schemas/authority-receipt.schema.json",
  "title": "Praxis authority receipt envelope v1",
  "description": "Validates envelope shape only; authenticity and consumption require a provider adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "project_id",
    "operation",
    "target_id",
    "from_state",
    "to_state",
    "content_digest",
    "plan_fingerprint",
    "scope",
    "authorizer_identity",
    "provider",
    "issued_at",
    "expires_at",
    "nonce",
    "single_use",
    "canonicalization",
    "payload_digest",
    "proof"
  ],
  "properties": {
    "schema": {"const": "praxis/authority-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 12},
    "project_id": {"$ref": "#/$defs/project_id"},
    "operation": {"type": "string", "minLength": 3},
    "target_id": {"type": "string", "minLength": 1},
    "from_state": {"type": ["string", "null"]},
    "to_state": {"type": ["string", "null"]},
    "content_digest": {"$ref": "#/$defs/digest"},
    "plan_fingerprint": {"$ref": "#/$defs/digest"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorizer_identity": {"type": "string", "minLength": 3},
    "provider": {"type": "string", "minLength": 3},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "single_use": {"const": true},
    "canonicalization": {"const": "RFC8785"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key_id", "algorithm", "signature", "provider_data"],
      "properties": {
        "type": {"type": "string", "minLength": 3},
        "key_id": {"type": "string", "minLength": 1},
        "algorithm": {"type": "string", "minLength": 3},
        "signature": {
          "type": "string",
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "provider_data": {"type": "object"}
      }
    }
  },
  "$defs": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
